# Contact and employment forms are emailed through Resend (https://resend.com); nothing is stored.
# chancetochange.us is verified in Resend. Each submission emails MAIL_TO and sends the visitor
# a confirmation (replies go to info@chancetochange.us).
RESEND_API_KEY=""                 # Resend dashboard > API keys (sending access is enough)
MAIL_FROM="Chance To Change <noreply@chancetochange.us>"
MAIL_TO="info@chancetochange.us"  # comma-separate several addresses

# Optional override for the Search Console token in src/app/layout.tsx
# GOOGLE_SITE_VERIFICATION="0HG2zbQGzfQoupp2wm4W2slKi-etuTVKjzlDsAqA9zw"
